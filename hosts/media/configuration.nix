      allowedTCPPorts = [ 22 2468 3553 5055 8096 8199 8989 7878 9696 16171 16172 ];
    };
    tailscale0 = {
      allowedTCPPorts = [ 22 2468 3553 5055 8096 8199 16171 16172 ];
    };
  };

