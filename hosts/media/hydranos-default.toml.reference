# Copie de référence de /config/hydra-qbit/default.toml sur `media`.
# NON déployé par Nix : ce fichier est un état runtime mutable (hydranos y
# écrit lui-même via son UI/API — network mode, trackers, engines…), pas une
# ressource déclarative. Juste une sauvegarde versionnée pour ne pas perdre
# la config si le disque lâche. À resynchroniser manuellement après un
# changement volontaire important (ex: `ssh media sudo cat
# /config/hydra-qbit/default.toml` puis réappliquer ce patch ici).
#
# Secrets retirés avant commit : [daemon] api_key et [auth] password_hash
# (régénérables localement : `hydra hash-password <password>` pour le hash,
# le bouton ↻ de l'UI ou l'API pour l'api_key).

[daemon]
agent_token = ""
api_host = "0.0.0.0"
api_port = 8199
api_key = "REDACTED"
data_dir = "/config"
create_torrent_folder = false

# ─────────────────────────────────────────────
# RACE SESSION - maximum aggressiveness (hot downloads)
# ─────────────────────────────────────────────
[race]
gluetun_port_forward = false
gluetun_url = ""
gluetun_api_key = ""
webseed_max_concurrent = 48
enable_webseed = true
enable_pex = true
enable_dht = true
start_paused = false
max_dials_per_sec = 0.0
announce_rate_limit = 0.0
enable_ipv6 = false
listen_port = 16171
bind_interface = ""
listen_interfaces = ""
max_connections = 4000
max_uploads_per_torrent = 100
peer_timeout = 30
inactivity_timeout = 20


[race.custom_choking]
enabled = true
tick_interval_seconds = 2
strategy = "rarity_captive"
max_unchoked = 30
rarity_weight = 0.7
speed_weight = 0.3

# ─────────────────────────────────────────────
# HOARD SESSION - upload-optimized (long-term seeding)
# ─────────────────────────────────────────────
[hoard]
gluetun_port_forward = false
gluetun_url = ""
gluetun_api_key = ""
webseed_max_concurrent = 48
enable_webseed = true
enable_pex = true
enable_dht = true
start_paused = false
max_dials_per_sec = 0.0
announce_rate_limit = 0.0
enable_ipv6 = false
listen_port = 16172
# bind_interface DOIT rester vide en mode [network] mode = "gluetun" : le
# renseigner (ex: "tun0") fait passer le kill switch d'Hydranos 4.4 en
# BLOCKED (moteur hors réseau, silencieusement) car gluetun gère déjà la
# protection via son propre firewall de netns. Bug vécu le 2026-10-26 :
# cette valeur était héritée d'un ancien setup et bloquait hoard depuis
# la migration hydra -> hydranos.
bind_interface = ""
listen_interfaces = ""
max_connections = 2000
max_uploads_per_torrent = -1
peer_timeout = 300
inactivity_timeout = 20

queueing = true
active_seeds = 40
active_limit = 50
active_downloads = 10
dont_count_slow_torrents = true

# ─────────────────────────────────────────────
# VPN SPEEDTEST
# ─────────────────────────────────────────────
[vpn_speedtest]
enabled = true
iperf3_server = "ping.online.net"
iperf3_port = 5201
interval_secs = 3600
duration_secs = 10

# ─────────────────────────────────────────────
# RACE DRAIN - automatic NVMe purge (hand back space)
# ─────────────────────────────────────────────
[race_drain]
reserve_free_gb = 0
add_block_enabled = true
age_ratio_action = "delete"
age_ratio_enabled = false
age_ratio_mode = "and"
min_ratio = 0.0
max_age_hours = 0
enabled = false
check_interval_seconds = 60
high_watermark_pct = 95
low_watermark_pct = 85
race_path = "/race"
min_age_minutes = 10

[auth]
username = "lego"
password_hash = "REDACTED"

# [hoard.disk_slots] (mode "HDD quiet" par disque) retiré : code mort en
# Hydranos 4.4, jamais lu par le moteur. La protection du disque passe
# par [hoard] queueing/active_seeds ci-dessus (plafonne les seeds actifs
# en simultané).

[announce_muted]
"gemini-tracker.org" = "1"
"c411.org" = "1"

[network]
mode = "gluetun"
