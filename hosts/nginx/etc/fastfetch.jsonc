// Custom fastfetch preset — nginx reverse proxy (Cyan theme)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "padding": {
            "top": 1,
            "right": 2
        },
        "color": {
            "1": "cyan",
            "2": "light_cyan"
        }
    },

    "display": {
        "separator": "  ",
        "color": {
            "separator": "cyan"
        },
        "constants": [
            "────────────────────────────────────────────────────────────────────────────────────────────",
            "│\u001b[92C│\u001b[92D"
        ],
        "bar": {
            "border": {
                "left":         "\uee00",
                "leftElapsed":  "\uee03",
                "right":        "\uee02",
                "rightElapsed": "\uee05"
            },
            "char": {
                "total":   "\uee01",
                "elapsed": "\uee04"
            },
            "width": 18,
            "color": {
                "total": null
            }
        },
        "percent": {
            "type": 3
        },
        "key": {
            "width": 14
        }
    },

    "modules": [
        {
            "format": "{#1}{#keys}╭{$1}╮\u001b[93D  {user-name-colored}{at-symbol-colored}{host-name-colored}",
            "type": "title"
        },
        {
            "key":  "{$2}{#33}{icon} os      ",
            "type": "os"
        },
        {
            "key":  "{$2}{#33}󰒔 kernel  ",
            "type": "kernel"
        },
        {
            "key":  "{$2}{#33}󰅐 uptime  ",
            "type": "uptime"
        },
        {
            "format": "{#1}{#keys}├{$1}┤",
            "type": "custom"
        },
        {
            "key":  "{$2}{#32}󰌢 host    ",
            "type": "host"
        },
        {
            "key":             "{$2}{#32}󰻠 cpu     ",
            "type":            "cpu",
            "temp":            true,
            "showPeCoreCount": true
        },
        {
            "key":  "{$2}{#32}󰍛 gpu     ",
            "type": "gpu"
        },
        {
            "format": "{#1}{#keys}├{$1}┤",
            "type": "custom"
        },
        {
            "type": "memory",
            "key":  "{$2}{#35}󰑭 ram     "
        },
        {
            "type":    "disk",
            "folders": "/",
            "key":     "{$2}{#35}󰋊 disk    "
        },
        {
            "format": "{#1}{#keys}├{$1}┤",
            "type": "custom"
        },
        {
            "type":   "command",
            "key":    "{$2}{#34}󰈀 lan     ",
            "text":   "ip -4 addr show ens18 2>/dev/null | grep 'inet ' | awk '{print $2}' | cut -d/ -f1 || echo 'down'"
        },
        {
            "type":   "command",
            "key":    "{$2}{#34}󰕥 ts      ",
            "text":   "ip -4 addr show tailscale0 2>/dev/null | grep 'inet ' | awk '{print $2}' | cut -d/ -f1 || echo 'down'"
        },
        {
            "type":   "command",
            "key":    "{$2}{#36}󰡨 pods    ",
            "text":   "sudo podman ps --format '{{.Names}}' 2>/dev/null | awk 'BEGIN{ split(\"36 32 33 34 35 31\", fg, \" \"); ORS=\"\" } NF && NR<=5 { i=(NR-1)%5+1; printf \"%s\\033[0;%sm%s\\033[0m\", (NR>1?\" • \":\"\"), fg[i], $0 } END { if (NR==0) print \"aucun\"; else print \"\" }'"
        },
        {
            "type":   "command",
            "key":    "{$2}{#36}          ",
            "text":   "sudo podman ps --format '{{.Names}}' 2>/dev/null | awk 'BEGIN{ split(\"34 31 33 35 32 36\", fg, \" \"); ORS=\"\" } NF && NR>5 { i=(NR-6)%5+1; printf \"%s\\033[0;%sm%s\\033[0m\", (NR>6?\" • \":\"\"), fg[i], $0 } END { print \"\" }'"
        },
        {
            "format": "{#1}{#keys}╰{$1}╯",
            "type": "custom"
        }
    ]
}
